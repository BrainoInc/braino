{
  "protocolVersion": 2,
  "id": "braino.ollama-embedding",
  "name": "Ollama embeddings",
  "version": "0.1.0",
  "capabilities": { "embedding.embed": 1 },
  "permissions": { "network": ["ollama:11434"] },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "default": "embeddinggemma-2:270m",
        "examples": ["embeddinggemma-2:270m", "embeddinggemma:300m"]
      },
      "dimensions": { "type": "string", "default": "768" }
    },
    "additionalProperties": false
  }
}
