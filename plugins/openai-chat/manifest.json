{
  "protocolVersion": 1,
  "id": "braino.openai-chat",
  "name": "OpenAI chat",
  "version": "0.1.0",
  "capabilities": ["chat.complete"],
  "permissions": { "network": ["api.openai.com"] },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "default": "gpt-4.1-mini",
        "examples": ["gpt-4.1-mini", "gpt-4.1", "gpt-4.1-nano"]
      }
    },
    "additionalProperties": false
  },
  "secretSchema": {
    "type": "object",
    "properties": {
      "api_key": { "type": "string" }
    },
    "required": ["api_key"],
    "additionalProperties": false
  }
}
