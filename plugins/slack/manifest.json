{
  "protocolVersion": 2,
  "id": "braino.slack",
  "name": "Señor Braino for Slack",
  "version": "0.1.0",
  "capabilities": {
    "event.receive": 1,
    "team_chat.connect": 1,
    "team_chat.send": 1
  },
  "permissions": { "network": ["slack.com"] },
  "secretSchema": {
    "type": "object",
    "properties": {
      "bot_token": { "type": "string", "title": "Slack bot token" },
      "signing_secret": { "type": "string", "title": "Slack signing secret" }
    },
    "required": ["bot_token", "signing_secret"],
    "additionalProperties": false
  }
}
