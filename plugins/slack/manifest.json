{
  "protocolVersion": 2,
  "id": "braino.slack",
  "name": "Señor Braino for Slack",
  "version": "0.2.0",
  "capabilities": {
    "event.receive": 1,
    "team_chat.connect": 1,
    "team_chat.send": 1
  },
  "permissions": { "network": ["*.braino.dev"] },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "gateway_url": {
        "type": "string",
        "title": "Braino plugin gateway",
        "default": "https://plugins.braino.dev"
      },
      "installation_id": { "type": "string", "title": "Gateway installation" }
    },
    "required": ["gateway_url", "installation_id"],
    "additionalProperties": false
  },
  "secretSchema": {
    "type": "object",
    "properties": {
      "gateway_secret": { "type": "string", "title": "Scoped gateway credential" }
    },
    "required": ["gateway_secret"],
    "additionalProperties": false
  }
}
