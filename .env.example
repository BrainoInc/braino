# Generate independent values with: openssl rand -base64 32
DOCO_ENCRYPTION_KEY=
BRAINO_POSTGRES_PASSWORD=
BRAINO_SETUP_TOKEN=
BRAINO_CODELINKER_API_TOKEN=
BRAINO_PLUGIN_HOST_API_TOKEN=

# Official Marketplace gateway used by first-party provider plugins.
BRAINO_PLUGIN_GATEWAY_URL=https://plugins.braino.dev

# Bundled local model defaults. The normal Compose boot starts Ollama and pulls
# both models; override these values to choose different local models.
# BRAINO_OLLAMA_IMAGE=ollama/ollama:0.40.16
# BRAINO_OLLAMA_CHAT_MODEL=qwen3.5:4b
# BRAINO_OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
# BRAINO_PLUGIN_LOCAL_NETWORK_HOSTS=ollama:11434

# Plain HTTP is the default supported local path.
BRAINO_PUBLIC_HOST=http://localhost:3000
BRAINO_HTTP_PORT=3000

# Optional: start `docker compose --profile tls up -d` with a DNS name that
# resolves to this host, then make the browser-visible origin match it.
# BRAINO_HOST=braino.example.com
# BRAINO_PUBLIC_HOST=https://braino.example.com

# Optional: use a released image instead of building this checkout.
# BRAINO_IMAGE=ghcr.io/brainoinc/braino:latest
# BRAINO_CODELINKER_IMAGE=ghcr.io/brainoinc/braino-codelinker:latest
# BRAINO_PLUGIN_HOST_IMAGE=ghcr.io/brainoinc/braino-plugin-host:latest
